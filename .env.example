# Copy to .env and fill in real values. NEVER commit the real .env file.
# Every value here is a placeholder — no real credential belongs in this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# This service's own externally-reachable base URL. Used to build every
# human-facing link posted to Linear: the gated auto-merge confirmation page
# (AUTO_MERGE_ON_DONE_ENABLED), the comment-deletion page (always on), and the
# scheduled-prompts create/delete web form links (SCHEDULED_PROMPTS_ENABLED).
# The default (localhost) is only correct if Linear itself is being opened on
# this same machine — set this to your ngrok tunnel or real deployment URL
# otherwise, or those links won't resolve for whoever clicks them.
PUBLIC_BASE_URL=http://localhost:8000

# Shared secret required (as an X-Api-Key header) to call AIDA-MATE's own
# JSON management API: GET/POST/PATCH/DELETE on /reviews* and
# /scheduled-prompts*. Neither router has any other authentication of its
# own — unlike the webhooks (HMAC-signed) and the human-facing HTML pages
# (gated on an unguessable token in their own URL). Fail-closed: unset means
# every request to these endpoints is rejected with 401, not silently
# allowed through. Security-audit finding — set a real value (a long random
# string) before deploying anywhere reachable by anyone but you.
MANAGEMENT_API_KEY=

# ---------------------------------------------------------------------------
# Linear (OAuth integration — see app/services/linear_auth_service.py)
# ---------------------------------------------------------------------------
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_REDIRECT_URI=http://localhost:8000/auth/linear/callback

# Comma-separated. `app:assignable` is what lets AIDA-MATE be delegated issues as
# an agent; `app:mentionable` lets it respond to @-mentions.
LINEAR_OAUTH_SCOPES=read,write,app:assignable,app:mentionable

# Reject webhooks older than this many seconds (replay protection).
LINEAR_WEBHOOK_MAX_AGE_SECONDS=60

# Optional. AIDA-MATE's own Linear actor ID is normally discovered automatically
# during OAuth install; set this only to override that.
AIDA_MATE_LINEAR_ACTOR_ID=

# Development-only fallback: a personal API key used instead of OAuth.
# Leave blank in production — OAuth is the supported path.
LINEAR_DEV_API_KEY=

# Local-dev convenience: persist OAuth installations here so a server restart
# doesn't force every workspace to reconnect, e.g. LINEAR_TOKEN_STORE_PATH=
# .local/linear_tokens.json. NOT encrypted at rest — keep this path out of
# version control, same as .env. Leave unset (default) for pure in-memory
# storage, matching production, where a real database store with encryption
# at rest is the intended path.
LINEAR_TOKEN_STORE_PATH=

# Review automatically whenever a ticket with a linked PR is created or
# updated, in addition to explicit delegation. Off by default — ticket edits
# are frequent, and each review costs a sandbox and LLM tokens. Content-level
# dedup still prevents re-reviewing an unchanged PR, so the real added cost is
# one PR lookup per ticket event.
LINEAR_AUTO_REVIEW_ENABLED=false

# Merge a pull request automatically when its Linear issue moves into a
# completed-type workflow state, if AIDA-MATE already holds a COMPLETED
# review for it (see CLAUDE.md §1a). LOW risk merges immediately with no
# confirmation; MEDIUM/HIGH require an explicit human "Yes, merge" via the
# confirmation page linked from a Linear comment (built from
# PUBLIC_BASE_URL) — never merged silently. Off by default: this is the only
# capability in AIDA-MATE that writes a merge to a repository.
AUTO_MERGE_ON_DONE_ENABLED=false

# Linear team key (e.g. "GIT", as shown in Linear's own UI/URLs) that
# GITHUB_ISSUE_SYNC_ENABLED creates issues under, and that new scheduled
# prompts (SCHEDULED_PROMPTS_ENABLED) are created against. Required for
# either of those flags to do anything.
LINEAR_SYNC_TEAM_KEY=

# ---------------------------------------------------------------------------
# GitHub (App installation — preferred)
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PEM private key. Either a literal PEM with \n escapes, or base64-encoded.
GITHUB_PRIVATE_KEY=

# Development-only fallback: a personal access token used instead of the App.
# Leave blank in production — the GitHub App is the supported path.
GITHUB_DEV_TOKEN=

# Override for GitHub Enterprise Server. Leave unset for github.com.
GITHUB_API_URL=https://api.github.com

# Comma-separated `owner/repo` entries searched when a Linear issue has no
# attached PR (branch-name / title fallback matching). Empty disables those
# fallbacks — only the Linear-attachment strategy runs. Also allowlists which
# repos GITHUB_MERGE_SYNC_ENABLED may act on and which repos a scheduled
# prompt (SCHEDULED_PROMPTS_ENABLED) is allowed to target — fail-closed: an
# empty allowlist means neither of those can touch any repo at all.
GITHUB_REPO_ALLOWLIST=

# Shared secret for verifying X-Hub-Signature-256 on inbound GitHub webhooks
# (see CLAUDE.md §1b/§1c). Required to receive any GitHub webhook traffic at
# all — unset means every delivery is rejected as unsigned (fail-closed).
# Needed only if GITHUB_MERGE_SYNC_ENABLED or GITHUB_ISSUE_SYNC_ENABLED is on.
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GitHub <-> Linear sync (see CLAUDE.md §1b/§1c). Both need GITHUB_WEBHOOK_SECRET
# above and a webhook configured on the GitHub repo side (Settings > Webhooks,
# payload URL {PUBLIC_BASE_URL}/webhooks/github, content type
# application/json, secret = GITHUB_WEBHOOK_SECRET).
# ---------------------------------------------------------------------------

# Move a Linear issue to a completed-type workflow state when its linked
# GitHub PR is merged into GITHUB_MERGE_SYNC_BRANCH, if AIDA-MATE already
# holds a COMPLETED review linking that PR to the issue. The reverse
# direction of AUTO_MERGE_ON_DONE_ENABLED. Off by default: this is the only
# capability in AIDA-MATE that writes a Linear issue's status automatically
# from GitHub activity. Needs the "Pull requests" webhook event subscribed.
GITHUB_MERGE_SYNC_ENABLED=false

# Only a PR merged into this base branch counts as "done" for
# GITHUB_MERGE_SYNC_ENABLED. A merge into any other branch (e.g. a
# staging/integration branch) is ignored.
GITHUB_MERGE_SYNC_BRANCH=main

# Create/update a Linear issue (under LINEAR_SYNC_TEAM_KEY) for GitHub Issues
# and security alerts (Code Scanning, Dependabot, Secret Scanning). Off by
# default. Pull requests by themselves, CI/Actions runs, and checks are never
# synced regardless of this flag — only those four sources. Closing a synced
# GitHub Issue moves its Linear issue to Done, and vice versa. Needs the
# "Issues", "Code scanning alerts", "Dependabot alerts", and "Secret scanning
# alerts" webhook events subscribed (same payload URL/secret as above).
GITHUB_ISSUE_SYNC_ENABLED=false

# ---------------------------------------------------------------------------
# Sandbox (Docker Sandboxes — the `docker sandbox` CLI plugin, confirmed
# installed alongside Docker Desktop; the standalone `sbx` binary the public
# docs describe is not required on this stack). Optional: without it, AIDA-MATE
# still runs its full deterministic area/risk/label pipeline, just without
# AI-generated findings layered on top.
#
# One-time manual setup this app cannot perform on its own:
#   1. Install/start Docker Desktop.
#   2. Authenticate the sandbox feature (`docker sandbox` prompts for this,
#      or run `sbx login` if you've also installed the standalone CLI).
#
# SANDBOX_MODE=local is a stopgap for hosts where Docker Sandboxes cannot run
# at all (e.g. no admin rights to install the WSL2 kernel update Docker
# Desktop needs). It extracts the PR to a host-side scratch temp directory
# instead of an isolated VM and runs the same read-only inspection there —
# nothing from the PR is ever executed as code — but this is NOT an
# isolation boundary. Prefer `docker` wherever it will actually run.
#
# KNOWN GAP as of this writing: Docker has deprecated and removed the
# `docker sandbox` CLI plugin this `docker` mode is built on (confirmed live
# — see CLAUDE.md §6) — on any current Docker install, SANDBOX_MODE=docker
# will fail every review outright rather than silently degrading (by
# design: an operator who enabled sandboxing should be told when it breaks,
# not have it quietly vanish — see app/agents/orchestrator.py's execute()).
# Use SANDBOX_MODE=local until a replacement adapter targeting Docker's
# actual current "Docker Sandboxes" product is built and verified.
# ---------------------------------------------------------------------------
SANDBOX_MODE=docker
SANDBOX_BINARY=docker
SANDBOX_TIMEOUT_SECONDS=900

# Wall-clock budget for the entire multi-agent analyze() run (Context, all
# specialists, and the Judge combined), independent of SANDBOX_TIMEOUT_SECONDS,
# which bounds individual sandboxed commands.
AGENT_TIMEOUT_SECONDS=300

# Per-agent budget inside one analyze() run (Context, each specialist).
# Without this, one hung specialist would stall the whole concurrent batch
# until AGENT_TIMEOUT_SECONDS fired and failed the entire review, instead of
# just that one specialist being recorded as failed.
SPECIALIST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Model provider — set MODEL_PROVIDER, then supply only that provider's key.
# ---------------------------------------------------------------------------
MODEL_PROVIDER=openai

OPENAI_API_KEY=
# Only needed for an organization-scoped OpenAI-compatible gateway/proxy
# instead of the default api.openai.com endpoint. Leave unset otherwise.
OPENAI_BASE_URL=
# Set alongside OPENAI_BASE_URL only for an Azure OpenAI / Azure AI Foundry
# endpoint (recognizable by its "api-version" query parameter requirement).
# Get the value from whoever provisioned the Azure resource/project.
OPENAI_API_VERSION=
# ANTHROPIC_API_KEY=

# Model IDs are configuration, never hardcoded. REVIEW_MODEL runs the four
# tool-using specialists and the Judge; UTILITY_MODEL runs the cheap,
# toolless Context Agent (orientation only, not investigation).
#
# For Azure OpenAI / Azure AI Foundry, both values must be real DEPLOYMENT
# names that already exist in your resource/project, not generic model names
# — an unrecognized value fails the Context Agent immediately with a 404
# DeploymentNotFound. If you have no separate cheap deployment yet, set
# UTILITY_MODEL to the same value as REVIEW_MODEL rather than guessing.
REVIEW_MODEL=gpt-5.6-sol
UTILITY_MODEL=gpt-5.6-luna

# Optional reasoning effort for supported models: low, medium, or high. Lower
# effort reduces latency and cost. Leave unset to use the model/provider
# default.
MODEL_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Persistence — review job state (separate from LINEAR_TOKEN_STORE_PATH above,
# which only covers OAuth installations). Set REVIEW_STORE_PATH and review
# state survives restarts: interrupted reviews become recoverable, retries
# have real history, and duplicate-review detection is enforced by a database
# UNIQUE index instead of a racy read-then-write.
#
# Leave unset (default) for pure in-memory storage — a restart loses all
# review state and interrupted reviews cannot be recovered or retried.
# ---------------------------------------------------------------------------
REVIEW_STORE_PATH=

# Reserved for a future server-backed database; unused today.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Risk policy — configurable thresholds, not hardcoded business rules
# ---------------------------------------------------------------------------
RISK_LOW_MAX_SCORE=20
RISK_MEDIUM_MAX_SCORE=60
MEDIUM_REQUIRES_HUMAN_REVIEW=false

# ---------------------------------------------------------------------------
# Review execution — bounds parallel reviews so a webhook burst can't exhaust
# sandbox quota or LLM budget.
# ---------------------------------------------------------------------------
REVIEW_CONCURRENCY=2
REVIEW_QUEUE_MAXSIZE=100

# ---------------------------------------------------------------------------
# Scheduled prompts (see CLAUDE.md §1d) — recurring, timezone-aware repo
# checks posted to Linear. Runs on a 60s timer, not a webhook. Off by
# default; structurally inert without GitHub credentials and a sandbox
# backend configured, same as the review pipeline's own agent-enrichment
# stage. Needs LINEAR_SYNC_TEAM_KEY (above) set, and GITHUB_REPO_ALLOWLIST
# to include whatever repos schedules are allowed to target.
# ---------------------------------------------------------------------------
SCHEDULED_PROMPTS_ENABLED=false
